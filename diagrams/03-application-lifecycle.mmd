stateDiagram-v2
    [*] --> Draft: Student Creates Application
    
    Draft --> Submitted: Submit Application<br/>(CV, Cover Letter)
    
    Submitted --> UnderReview: Employer Receives Application
    
    UnderReview --> Shortlisted: Employer Reviews & Shortlists
    
    UnderReview --> Rejected: Employer Rejects Application
    
    Shortlisted --> InterviewScheduled: Schedule Interview<br/>(Stage 1: Initial)
    
    InterviewScheduled --> InterviewCompleted: Complete Interview
    
    InterviewCompleted --> TechnicalRound: Pass Initial Interview<br/>(Stage 2: Technical)
    
    InterviewCompleted --> Rejected: Fail Interview
    
    TechnicalRound --> TechnicalCompleted: Complete Technical Round
    
    TechnicalCompleted --> FinalRound: Pass Technical<br/>(Stage 3: Final)
    
    TechnicalCompleted --> Rejected: Fail Technical
    
    FinalRound --> FinalCompleted: Complete Final Round
    
    FinalCompleted --> OfferExtended: Pass All Rounds<br/>(Stage 4: Offer)
    
    FinalCompleted --> Rejected: Fail Final Round
    
    OfferExtended --> ContractSent: Student Accepts Offer
    
    OfferExtended --> OfferDeclined: Student Declines Offer
    
    ContractSent --> ContractSigned: E-Signature Completed<br/>(Stage 5: Contract)
    
    ContractSigned --> Hired: Contract Active<br/>(Stage 6: Hired)
    
    ContractSigned --> ContractDissolved: Contract Dissolved<br/>(Penalty Applied if Applicable)
    
    Rejected --> [*]: Application Closed
    
    OfferDeclined --> [*]: Application Closed
    
    ContractDissolved --> [*]: Application Closed
    
    Hired --> [*]: Application Complete
    
