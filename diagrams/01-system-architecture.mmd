    classDef business fill:#6c5ce7,stroke:#333,stroke-width:2px,color:#fff
    classDef data fill:#a29bfe,stroke:#333,stroke-width:2px,color:#fff
    classDef database fill:#fd79a8,stroke:#333,stroke-width:2px,color:#000
    classDef external fill:#00b894,stroke:#333,stroke-width:2px,color:#000
    classDef user fill:#e17055,stroke:#333,stroke-width:2px,color:#fff

    class UI,Pages,Redux,Hooks frontend
    class AuthAPI,JobAPI,AppAPI,EmployerAPI,AdminAPI,SavedAPI api
    class Middleware,RBAC,AuthCheck middleware
    class AuthHandler,JobService,AppService,ContractService,MessageService,AIService,NotifyService,AdminService business
    class Mongoose,Models data
    class UserCollection,JobCollection,AppCollection,ContractCollection,MessageCollection,AnalyticsCollection database
    class Cloudinary,EmailService,ESignature,MLService external
